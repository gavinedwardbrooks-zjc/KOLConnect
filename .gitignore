# Python bytecode and interpreter caches
__pycache__/
**/__pycache__/
*.pyc
*.pyo
*.py[cod]

# PyInstaller build outputs
packaging/.pyinstaller-build/
packaging/.pyinstaller-dist/
packaging/.pyinstaller-build-macos/
packaging/.pyinstaller-dist-macos/
packaging/.macos-dmg-staging/
packaging/*.iconset/
/build/
/dist/
/release_candidate/
*.spec.backup
.pytest_cache/
*.exe
*.dmg
/release/

# JavaScript dependency directories
node_modules/

# Local runtime data and private configuration
tasks/
logs/
userdata/
runtime/
app_state.json
mail_messages.json
data_protection.json
settings.json
window_state.json
*.log
*.bak
*.tmp
*.csv
*.xlsx
*.xls
*.xlsm
~$*.xlsx
ChromeProfile/

# Local credentials and environment overrides
.env
.env.*
!.env.example
*.key
*.pem
*.pfx
*.p12
credentials.json
credentials.*.json
cookies.json
cookies/
*.local.json

# Browser and driver caches
.wdm/
release/resources/
assets/KOLConnect.icns

# Historical private backup data must not enter source control
archive/private-data-backup/
