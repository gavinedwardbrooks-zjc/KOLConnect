# Optional command-line compatibility variables for scraper.py four-table runs.
# The desktop application does not read this file: configure Feishu in Settings,
# where values are stored in the local user settings file. Do not commit real
# credentials in a local .env file.

FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_APP_TOKEN=
FEISHU_CREATOR_TABLE_ID=
FEISHU_ACCOUNT_TABLE_ID=

# Mail account examples. The desktop app stores account settings locally.
EMAIL_ACCOUNT=
EMAIL_PASSWORD=
